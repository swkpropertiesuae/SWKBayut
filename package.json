{
  "name": "swk-bayut-uae-rental-os",
  "version": "1.0.0",
  "private": true,
  "description": "SWKBayut — UAE's First OS-Backed Dedicated Rental Marketplace, BTR Developer Engine & Native Android App (Powered by SWK Properties OS, RERA ORN 51517)",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c emerald,graphite \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build",
    "build:api": "esbuild src/server/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/server/index.mjs --packages=external --sourcemap",
    "start": "node dist/server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx tests/rental-suite.ts",
    "android:sync": "npm run build:web && node tools/android/sync-assets.mjs",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:aab": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.12.7",
    "motion": "^14.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.1.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.1.0",
    "@tailwindcss/vite": "^4.1.16",
    "@tanstack/react-query": "^5.90.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.1.0",
    "esbuild": "^0.25.11",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
